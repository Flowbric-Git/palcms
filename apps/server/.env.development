# Configuration de développement (Windows / Mac / Linux), chargée uniquement hors production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BASE_PATH=/
PUBLIC_URL=http://localhost:5173
DATA_DIR=./.data
# Faux palctl : simule l'installation et le service Palworld sans rien toucher au système.
PALCTL=node ../../tools/fake-palctl/palctl.mjs
PALWORLD_API_HOST=127.0.0.1
POLL_INTERVAL_MS=5000
