# Development configuration (Windows / Mac / Linux), only loaded outside production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BASE_PATH=/
PUBLIC_URL=http://localhost:5173
DATA_DIR=./.data
# Fake palctl: simulates the install and the Palworld service without touching the system.
PALCTL=node ../../tools/fake-palctl/palctl.mjs
PALWORLD_API_HOST=127.0.0.1
POLL_INTERVAL_MS=5000
# Fake market (tools/fake-market) and its dev signing key.
PALCMS_MARKET_URL=http://127.0.0.1:3100/api/market
PALCMS_TRUSTED_KEYS=../../tools/.dev-data/market-dev-public.pem
