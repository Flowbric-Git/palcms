 "pages": [
  {
   "id": 2,
   "slug": "rejoindre",
   "title": "Rejoindre le serveur",
   "contentHtml": "<h2>Comment nous rejoindre</h2>\n<ol>\n<li>Lance Palworld et choisis <strong>Rejoindre une partie multijoueur</strong>.</li>\n<li>En bas de l'écran, saisis l'adresse du serveur affichée sur l'accueil du site.</li>\n<li>Entre le mot de passe si le serveur en a un.</li>\n</ol>\n<p>Rejoins aussi notre <a href=\"https://discord.gg/exemple\">Discord</a> !</p>",
   "published": true,
   "updatedAt": -1036800000
  },
  {
   "id": 1,
   "slug": "regles",
   "title": "Règles du serveur",
   "contentHtml": "<h2>Règles générales</h2>\n<ol>\n<li>Respecte les autres joueurs : pas d'insultes ni de harcèlement.</li>\n<li>Pas de triche, d'exploit de bug ou de logiciel tiers.</li>\n<li>Ne détruis pas les bases des autres joueurs sans leur accord.</li>\n<li>Écoute les décisions des administrateurs.</li>\n</ol>\n<p>Ces règles sont modifiables dans le panel admin, rubrique <em>Gestion du site &gt; Pages</em>.</p>",
   "published": true,
   "updatedAt": -1036800000
  }
 ],
 "news": [
  {
   "id": 3,
   "slug": "nouvelle-carte-en-direct",
   "title": "Nouvelle carte en direct",
   "excerpt": "Suivez la position des joueurs connectés et les points importants directement sur le site.",
   "coverUrl": null,
   "publishedAt": -86400000,
   "author": "admin",
   "contentHtml": "<p>La carte en direct est disponible dans le menu : positions des joueurs en temps réel, bases de la communauté et points d'intérêt.</p>",
   "published": true
  },
  {
   "id": 2,
   "slug": "evenement-du-week-end-chasse-aux-alphas",
   "title": "Événement du week-end : chasse aux alphas",
   "excerpt": "Samedi soir, on part ensemble à la chasse aux Pals alpha. Rendez-vous au point de départ.",
   "coverUrl": null,
   "publishedAt": -345600000,
   "author": "admin",
   "contentHtml": "<p>Samedi à 21h, grosse sortie en groupe pour affronter les Pals alpha de l'île. Rendez-vous au point <em>Spawn</em> sur la carte.</p><ul><li>Niveau 20 conseillé</li><li>Pensez aux soins</li></ul>",
   "published": true
  },
  {
   "id": 1,
   "slug": "ouverture-du-serveur",
   "title": "Ouverture du serveur !",
   "excerpt": "Le serveur ouvre ses portes : taux d'XP x1,5, capture facilitée et sauvegardes toutes les heures.",
   "coverUrl": null,
   "publishedAt": -1123200000,
   "author": "admin",
   "contentHtml": "<p>Bienvenue à tous ! Le serveur est ouvert, rejoignez-nous depuis la liste des serveurs communautaires ou avec l'adresse affichée sur l'accueil.</p><p>Au programme : <strong>XP x1,5</strong>, capture facilitée, sauvegardes automatiques toutes les heures.</p>",
   "published": true
  }
 ],
