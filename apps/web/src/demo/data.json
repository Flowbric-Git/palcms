  "pages": [
    {
      "id": 2,
      "slug": "join",
      "title": "Join the server",
      "contentHtml": "<h2>How to join us</h2>\n<ol>\n<li>Start Palworld and choose <strong>Join Multiplayer Game</strong>.</li>\n<li>At the bottom of the screen, enter the server address shown on the site's home page.</li>\n<li>Enter the password if the server has one.</li>\n</ol>\n<p>Join our <a href=\"https://discord.gg/example\">Discord</a> too!</p>",
      "published": true,
      "updatedAt": -1036800000
    },
    {
      "id": 1,
      "slug": "rules",
      "title": "Server rules",
      "contentHtml": "<h2>General rules</h2>\n<ol>\n<li>Respect other players: no insults or harassment.</li>\n<li>No cheating, bug exploits or third-party software.</li>\n<li>Don't destroy other players' bases without their consent.</li>\n<li>Follow the administrators' decisions.</li>\n</ol>\n<p>These rules can be edited in the admin panel, under <em>Website &gt; Pages</em>.</p>",
      "published": true,
      "updatedAt": -1036800000
    }
  ],
  "news": [
    {
      "id": 3,
      "slug": "new-live-map",
      "title": "New live map",
      "excerpt": "Follow online players and key places right on the site.",
      "coverUrl": null,
      "publishedAt": -86400000,
      "author": "admin",
      "contentHtml": "<p>The live map is now in the menu: player positions in real time, community bases and points of interest.</p>",
      "published": true
    },
    {
      "id": 2,
      "slug": "weekend-event-alpha-hunt",
      "title": "Weekend event: alpha hunt",
      "excerpt": "Saturday night, we go hunting alpha Pals together. Meet at the spawn point.",
      "coverUrl": null,
      "publishedAt": -345600000,
      "author": "admin",
      "contentHtml": "<p>Saturday at 9 pm, big group outing to take on the alpha Pals of the island. Meet at the <em>Spawn</em> point on the map.</p><ul><li>Level 20 recommended</li><li>Bring healing items</li></ul>",
      "published": true
    },
    {
      "id": 1,
      "slug": "server-launch",
      "title": "The server is open!",
      "excerpt": "The server opens its doors: XP rate x1.5, easier captures and hourly backups.",
      "coverUrl": null,
      "publishedAt": -1123200000,
      "author": "admin",
      "contentHtml": "<p>Welcome, everyone! The server is open: find it in the community server list or use the address shown on the home page.</p><p>On the menu: <strong>XP x1.5</strong>, easier captures, automatic backups every hour.</p>",
      "published": true
    }
  ],
