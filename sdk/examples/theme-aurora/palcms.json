{
  "id": "aurora",
  "type": "theme",
  "name": "Aurora",
  "version": "1.1.0",
  "description": "Dark theme with northern-lights gradients: centered header, large banner with the server status and a footer in columns.",
  "author": "PalCMS",
  "palcms": ">=1.1.0",
  "icon": "assets/icon.png",
  "settings": [
    { "key": "from", "type": "color", "label": "Gradient color (start)", "default": "#22d3ee" },
    { "key": "to", "type": "color", "label": "Gradient color (end)", "default": "#a855f7" },
    { "key": "heroImage", "type": "image", "label": "Banner image", "description": "Leave empty for an animated background." },
    { "key": "heroTitle", "type": "text", "label": "Banner title", "description": "Empty: title set in Appearance." },
    { "key": "showStatus", "type": "toggle", "label": "Server status in the banner", "default": true },
    {
      "key": "headerStyle",
      "type": "select",
      "label": "Header style",
      "default": "centered",
      "options": [
        { "value": "centered", "label": "Centered logo" },
        { "value": "classic", "label": "Classic (the PalCMS one)" }
      ]
    },
    { "key": "footerText", "type": "textarea", "label": "Footer text", "description": "Empty: text set in Appearance." }
  ]
}
